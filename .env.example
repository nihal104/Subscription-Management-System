DATABASE_URL=postgres://user:password@localhost:5432/brightloop
JWT_SECRET=replace-with-a-long-random-string
APP_URL=http://localhost:5173
PORT=3000

# Email for password resets (https://resend.com). Leave empty to print emails in the log.
RESEND_API_KEY=
MAIL_FROM=Brightloop <billing@yourdomain.com>
# Online card payments (https://stripe.com). Leave empty to turn "Pay online" off.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
CURRENCY=usd
